<?xml version="1.0" encoding="utf-8"?>
<!-- One tile in a RowList row. -->
<component name="HubItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent" />
    <field id="focusPercent" type="float" onChange="onFocus" />
  </interface>
  <script type="text/brightscript" uri="pkg:/components/HubItem.brs" />
  <children>
    <Rectangle id="bg" width="320" height="240" color="0x1C232DFF" />
    <Poster id="poster" width="320" height="180" loadDisplayMode="scaleToFit" />
    <Label id="label" translation="[14,186]" width="292" height="48"
           font="font:SmallSystemFont" color="0xE6EDF3FF" vertAlign="center" />
  </children>
</component>
